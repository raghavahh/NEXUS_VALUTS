# ==============================================================================
#                 AI Video Factory - EXAMPLE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your personal API keys and credentials.
# No credentials or secrets should ever be committed to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI TEXT PROVIDER KEYS (Required for LLM routing)
#    Configure at least ONE text provider API key for the system to function.
# ------------------------------------------------------------------------------
# Primary: NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=

# Fallback 1: Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Fallback 2: Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# Fallback 3: OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. AI VIDEO PROVIDER KEYS (Optional - for AI video generation)
# ------------------------------------------------------------------------------
# Runway Gen-3 (https://runwayml.com/)
RUNWAY_API_KEY=

# Pika Labs (https://pika.art/)
PIKA_API_KEY=

# Luma Dream Machine (https://lumalabs.ai/)
LUMA_API_KEY=

# ------------------------------------------------------------------------------
# 3. YOUTUBE PUBLISHER (Required for uploading)
# ------------------------------------------------------------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 4. ATMOSPHERIC VISUALS (Optional: https://www.pexels.com/api/)
# ------------------------------------------------------------------------------
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# 5. APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
APP_ENV=development
APP_MODE=test
DEBUG=false
LOG_LEVEL=INFO
CHANNEL_NAME=NEXUS VAULTS
CHANNEL_HANDLE=NEXUS_VAULTS
CHANNEL_NICHE=history
CHANNEL_AUDIENCE=curious viewers of documented mysteries and real history
CHANNEL_LANGUAGE=en
CHANNEL_REGION=US

# ------------------------------------------------------------------------------
# 6. AI TEXT PROVIDER CHAIN & SETTINGS
#    Order determines fallback priority. Each slot can be configured individually.
# ------------------------------------------------------------------------------
AI_TEXT_PROVIDER_CHAIN=nvidia,groq,gemini,openrouter
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=1

# Per-provider text model & endpoint (uses secret_ref above for API key)
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

GROQ_MODEL=qwen/qwen3-8b
GROQ_API_URL=https://api.groq.com/openai/v1

GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 7. AI VIDEO PROVIDER CHAIN & SETTINGS
# ------------------------------------------------------------------------------
AI_VIDEO_PROVIDER_CHAIN=runway,pika,luma

RUNWAY_MODEL=gen3a_turbo
RUNWAY_API_URL=https://api.runwayml.com/v1

PIKA_MODEL=pika-1.0
PIKA_API_URL=https://api.pika.art/v1

LUMA_MODEL=dream-machine
LUMA_API_URL=https://api.lumalabs.ai/v1

# ------------------------------------------------------------------------------
# 8. MEDIA MODE (FFmpeg vs AI Video Generation)
# ------------------------------------------------------------------------------
MEDIA_MODE=ffmpeg
FFMPEG_PRESET=fast
AI_VIDEO_PROVIDER=runway
AI_VIDEO_MODEL=gen3a_turbo
FALLBACK_TO_FFMPEG=true

# ------------------------------------------------------------------------------
# 9. YOUTUBE METADATA & UPLOAD SETTINGS
# ------------------------------------------------------------------------------
YOUTUBE_CATEGORY_ID=28
YOUTUBE_DEFAULT_LANGUAGE=en
YOUTUBE_UPLOAD_PRIVACY=private

# ------------------------------------------------------------------------------
# 10. RESEARCH
# ------------------------------------------------------------------------------
RESEARCH_MAX_TOPICS=5
RESEARCH_MAX_CANDIDATES=3
RESEARCH_CONTENT_PILLARS=Classified History,Unexplained Events,Scientific Mysteries,Strange Real Events

# ------------------------------------------------------------------------------
# 11. STORYBOARD & SCENE SETTINGS
# ------------------------------------------------------------------------------
STORY_MIN_DURATION=30.0
STORY_MAX_DURATION=40.0
STORY_TARGET_DURATION=36.0
STORY_MIN_WORDS=68
STORY_MAX_WORDS=84
SCENE_MIN_COUNT=10
SCENE_MAX_COUNT=15
SCENE_MIN_AUTHENTIC_ASSETS=4
SCENE_MAX_GENERATED_GRAPHICS=3

# ------------------------------------------------------------------------------
# 12. RENDERING
# ------------------------------------------------------------------------------
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CODEC=libx264
RENDER_CRF=20
RENDER_PRESET=fast
RENDER_AUDIO_CODEC=aac
RENDER_AUDIO_BITRATE=192k

# ------------------------------------------------------------------------------
# 13. AUDIO & CAPTIONS
# ------------------------------------------------------------------------------
AUDIO_VOICE=en-US-ChristopherNeural
AUDIO_RATE=+4%
AUDIO_PITCH=-2Hz
AUDIO_VOICE_VOLUME=-3.0
AUDIO_BACKGROUND_VOLUME=-28.0
AUDIO_DUCKING_ATTENUATION_DB=-26.0
AUDIO_LOUDNORM_I=-14.0
AUDIO_LOUDNORM_TP=-1.5
AUDIO_LOUDNORM_LRA=11.0
AUDIO_TRANSITION_SFX_ENABLED=true
CAPTION_FONT=Arial Black
CAPTION_FONT_SIZE=68
CAPTION_WORDS_PER_LINE=4

# ------------------------------------------------------------------------------
# 14. SEO
# ------------------------------------------------------------------------------
SEO_TITLE_MAX_LENGTH=58
SEO_DESCRIPTION_MAX_LENGTH=500
SEO_TAG_MAX_COUNT=10

# ------------------------------------------------------------------------------
# 15. QUALITY CONTROL (QC)
# ------------------------------------------------------------------------------
QC_MIN_DURATION=30.0
QC_MAX_DURATION=40.0
QC_MIN_SCENES=10
QC_MAX_SCENES=15
QC_REQUIRE_UNIQUE_ASSETS=true
QC_REQUIRE_FRAME_VERIFICATION=true
QC_FRAME_SAMPLE_OFFSET=0.5
QC_FRAME_MATCH_THRESHOLD=0.40
QC_SAMPLE_POINTS_PER_SCENE=3
QC_DURATION_TOLERANCE=0.5

# ------------------------------------------------------------------------------
# 16. SCHEDULING & CLOCK
# ------------------------------------------------------------------------------
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_UPLOAD_HOUR=19
SCHEDULE_UPLOAD_MINUTE=0
SCHEDULE_READY_BUFFER_MINUTES=60
MIN_UPLOAD_GAP_HOURS=18

# ------------------------------------------------------------------------------
# 17. STORAGE & DATABASE
# ------------------------------------------------------------------------------
# State (database, temp) lives in .factory_state/, OUTPUT is separate
DATABASE_PATH=.factory_state/channel.db
TEMP_DIR=.factory_state/temp
OUTPUT_DIR=OUTPUT
STORYBOARD_DIR=OUTPUT/storyboard
STATE_DIR=.factory_state
STORAGE_CLEANUP_TEMP=true
STORAGE_KEEP_FINAL_OUTPUT=true

# ------------------------------------------------------------------------------
# 18. ANALYTICS & SELF-LEARNING FEEDBACK LOOP
# ------------------------------------------------------------------------------
# Performance score formula weights (bootstrap heuristic -- must sum to 1.0)
# Recalibrate after ANALYTICS_MIN_SAMPLE_COUNT videos have been published.
ANALYTICS_SCORE_WEIGHT_HOOK=0.35
ANALYTICS_SCORE_WEIGHT_RETENTION=0.35
ANALYTICS_SCORE_WEIGHT_ENGAGEMENT=0.15
ANALYTICS_SCORE_WEIGHT_SUBS=0.15
# Minimum samples before weight updates are committed (bootstrap guard)
ANALYTICS_MIN_SAMPLE_COUNT=3
# Only analytics within this many days affect weight updates
ANALYTICS_OBSERVATION_WINDOW_DAYS=90

# ------------------------------------------------------------------------------
# 19. TESTING & PIPELINE GATES
# ------------------------------------------------------------------------------
TEST_MODE=true
TEST_DRY_RUN=false
# TEST_SKIP_UPLOAD only affects local dev/test runs. Never set in production.
# Production upload gate is governed by APP_MODE=production only.
TEST_SKIP_UPLOAD=true
TEST_KEEP_ARTIFACTS=true
TEST_FORCE_TOPIC=
